  "types": [
    {
      "name": "Allowance",
      "docs": [
        "A monthly allowance: `[ALLOWANCE_SEED, dao, id]`. The recipient claims",
        "`amount` of `mint` (None: SOL) once per 30-day period from `start` until",
        "`ends_at`; a period not claimed lapses."
      ],
      "type": {
        "kind": "struct",
        "fields": [
