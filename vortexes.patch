+    pub voter: Account<'info, Voter>,
+    #[account(mut, seeds = [VOTER_SEED, governance.key().as_ref(), voter.delegate.as_ref()], bump = delegate_voter.bump)]
+    pub delegate_voter: Account<'info, Voter>,
+}
