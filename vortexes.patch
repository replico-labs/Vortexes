+impl Proposal {
+    pub fn space(metadata_uri: &str, instructions: &[StoredInstruction]) -> usize {
+        8 + (32 + 4 + vortex_core::instructions_len(instructions))
+            + 32 + 8 + 32
+            + (4 + metadata_uri.len())
+            + Criteria::INIT_SPACE
+            + Phase::INIT_SPACE
+            + 8 * 3 + Votes::INIT_SPACE
+            + 8 * 3
+            + 8 * 3
+            + 32 + 8 + Outcome::INIT_SPACE + 8
+            + 32 + 8 + 8 + 8
+            + 8 * 2 + Outcome::INIT_SPACE
+            + 8 * 3
+            + 1
+    }
+}
