+#[test]
+fn a_token_weighted_dao_can_switch_to_liquid() {
+    let (mut env, alice, bob) = dao_with_members();
+    let init_liquid = stored(env.ix_init_governance(LIQ, &env.treasury, &env.treasury, config()));
+    let switch = env.pass(TW, &alice, vec![stored(env.ix_propose_switch(LIQ)), init_liquid]);
+    env.execute(TW, switch).unwrap();
+    let ready = env.hub_dao().pending_switch.expect("switch pending").ready_at;
+    env.warp(ready);
+    env.apply_switch(LIQ).unwrap();
+    assert_eq!(env.hub_dao().governance_program, LIQ);
+
+    // Members move their tokens over and delegate; the same treasury pays out.
+    env.withdraw(TW, &alice, 600).unwrap();
+    env.withdraw(TW, &bob, 400).unwrap();
+    deposit(&mut env, &alice, 600, None).unwrap();
+    deposit(&mut env, &bob, 400, None).unwrap();
+    delegate(&mut env, &bob, &alice.kp.pubkey()).unwrap();
+    let p = propose(&mut env, &alice).unwrap();
+    let prop = proposal(&env, p);
+    env.warp(prop.voting_starts_at);
+    vote(&mut env, &alice, p, Choice::For).unwrap();
+    assert_eq!(tally(&env, p), (1_000, 0, 0));
+    env.warp(prop.voting_ends_at);
+    queue(&mut env, p).unwrap();
+    env.warp(prop.voting_ends_at + config().timelock as i64);
+    env.execute(LIQ, p).unwrap();
+}
diff --git a/tests/tests/sortition.rs b/tests/tests/sortition.rs
new file mode 100644
index 0000000..e610a1c
--- /dev/null
+++ b/tests/tests/sortition.rs
@@ -0,0 +1,360 @@
+//! Sortition: the opt-in pool, ORAO-randomness draws, restarts, and the
+//! drawn council governing through the hub.
+
+use solana_account::Account;
+use vortex_sortition as sort;
+use vortex_sortition::{SortitionConfig, VoteChoice as Choice};
+use vortex_tests::*;
+
+fn sort_config(seats: u8) -> SortitionConfig {
+    SortitionConfig {
+        council_size: seats,
+        term_length: 1_000,
+        eligibility_threshold: 100,
+        council_quorum: 2.min(seats),
+        council_approval_bps: 6_000,
+        voting_delay: 10,
+        voting_period: 100,
+        timelock: 50,
+        execution_period: 200,
+        randomness_timeout: 60,
+    }
+}
+
+fn pool_pda(env: &Env) -> Pubkey {
+    Pubkey::find_program_address(&[sort::POOL_SEED, env.governance(SORT).as_ref()], &SORT).0
+}
+
+fn governance(env: &Env) -> sort::Governance {
+    sort::Governance::try_deserialize(&mut env.svm.get_account(&env.governance(SORT)).unwrap().data.as_slice()).unwrap()
+}
+
+fn pool(env: &Env) -> Vec<Pubkey> {
+    sort::Pool::try_deserialize(&mut env.svm.get_account(&pool_pda(env)).unwrap().data.as_slice()).unwrap().members
+}
+
+/// A sortition DAO (council: the creator) and `n` members with 100 deposited each.
+fn sortition_dao(seats: u8, n: usize) -> (Env, Vec<Member>) {
+    let mut env = Env::bare(litesvm_token::TOKEN_ID);
+    let creator = env.creator.pubkey();
+    let config = SortitionConfig { council_size: 1, council_quorum: 1, ..sort_config(seats) };
+    env.create_dao("Lots", SORT, |env| Instruction {
+        program_id: SORT,
+        accounts: sort::accounts::InitGovernance {
+            authority: creator,
+            payer: creator,
+            hub_dao: env.dao,
+            governance: env.governance(SORT),
+            pool: pool_pda(env),
+            mint: env.mint,
+            vault: env.vault(SORT),
+            token_program: env.token_program,
+            system_program: SYSTEM,
+        }
+        .to_account_metas(None),
+        data: sort::instruction::InitGovernance { council: vec![creator], config }.data(),
+    });
+    // Seats for later draws come from a config update; for these tests the
+    // DAO starts with `seats` straight away.
+    let mut g = governance(&env);
+    g.config = sort_config(seats);
+    let address = env.governance(SORT);
+    write(&mut env, address, &g);
+    let members = (0..n)
+        .map(|_| {
+            let m = env.member(1_000);
+            deposit(&mut env, &m, 100).unwrap();
+            m
+        })
+        .collect();
+    env.svm.airdrop(&env.treasury, 5_000_000_000).unwrap();
+    (env, members)
+}
+
+fn write<T: anchor_lang::AccountSerialize>(env: &mut Env, address: Pubkey, value: &T) {
+    let mut account = env.svm.get_account(&address).unwrap();
+    let mut data = Vec::new();
+    value.try_serialize(&mut data).unwrap();
+    account.data[..data.len()].copy_from_slice(&data);
+    env.svm.set_account(address, account).unwrap();
+}
+
+fn deposit(env: &mut Env, m: &Member, amount: u64) -> Result<(), FailedTransactionMetadata> {
+    let ix = Instruction {
+        program_id: SORT,
+        accounts: sort::accounts::Deposit {
+            owner: m.kp.pubkey(),
+            governance: env.governance(SORT),
+            voter: env.voter_pda(SORT, &m.kp.pubkey()),
+            owner_token_account: m.ata,
+            vault: env.vault(SORT),
+            mint: env.mint,
+            token_program: env.token_program,
+            system_program: SYSTEM,
+        }
+        .to_account_metas(None),
+        data: sort::instruction::Deposit { amount }.data(),
+    };
+    env.send(&[ix], &[&m.kp])
+}
+
+fn withdraw(env: &mut Env, m: &Member, amount: u64) -> Result<(), FailedTransactionMetadata> {
+    let ix = Instruction {
+        program_id: SORT,
+        accounts: sort::accounts::Withdraw {
+            owner: m.kp.pubkey(),
+            governance: env.governance(SORT),
+            voter: env.voter_pda(SORT, &m.kp.pubkey()),
+            owner_token_account: m.ata,
+            vault: env.vault(SORT),
+            mint: env.mint,
+            token_program: env.token_program,
+        }
+        .to_account_metas(None),
+        data: sort::instruction::Withdraw { amount }.data(),
+    };
+    env.send(&[ix], &[&m.kp])
+}
+
+fn pool_action(env: &mut Env, m: &Member, join: bool) -> Result<(), FailedTransactionMetadata> {
+    let accounts = sort::accounts::PoolAction {
+        owner: m.kp.pubkey(),
+        governance: env.governance(SORT),
+        pool: pool_pda(env),
+        voter: env.voter_pda(SORT, &m.kp.pubkey()),
+    }
+    .to_account_metas(None);
+    let data = if join { sort::instruction::JoinPool {}.data() } else { sort::instruction::LeavePool {}.data() };
+    env.send(&[Instruction { program_id: SORT, accounts, data }], &[&m.kp])
+}
+
+fn randomness_address(seed: &[u8; 32]) -> Pubkey {
+    Pubkey::find_program_address(&[sort::ORAO_REQUEST_SEED, seed], &sort::ORAO_VRF).0
+}
+
+/// ORAO's RandomnessV2 account, as ORAO would leave it: pending, or fulfilled with `randomness`.
+fn set_orao(env: &mut Env, seed: &[u8; 32], randomness: Option<[u8; 64]>, owner: Pubkey) {
+    let mut data = sort::ORAO_RANDOMNESS_V2.to_vec();
+    let client = Pubkey::new_unique();
+    match randomness {
+        None => {
+            data.push(0);
+            data.extend_from_slice(client.as_ref());
+            data.extend_from_slice(seed);
+            data.extend_from_slice(&0u32.to_le_bytes()); // no responses yet
+        }
+        Some(r) => {
+            data.push(1);
+            data.extend_from_slice(client.as_ref());
+            data.extend_from_slice(seed);
+            data.extend_from_slice(&r);
+        }
+    }
+    let account = Account { lamports: 10_000_000, data, owner, executable: false, rent_epoch: 0 };
+    env.svm.set_account(randomness_address(seed), account).unwrap();
+}
+
+fn start_draw(env: &mut Env, nonce: [u8; 32], previous: Option<[u8; 32]>) -> Result<[u8; 32], FailedTransactionMetadata> {
+    let g = governance(env);
+    let number = if g.draw_open { g.draw_count } else { g.draw_count + 1 };
+    let seed = sort::draw_seed(&env.governance(SORT), number, &nonce);
+    let ix = Instruction {
+        program_id: SORT,
+        accounts: sort::accounts::StartDraw {
+            governance: env.governance(SORT),
+            pool: pool_pda(env),
+            randomness: randomness_address(&seed),
+            previous_randomness: randomness_address(&previous.unwrap_or(seed)),
+        }
+        .to_account_metas(None),
+        data: sort::instruction::StartDraw { nonce }.data(),
+    };
+    let admin = env.admin.insecure_clone();
+    env.send(&[ix], &[&admin]).map(|_| seed)
+}
+
+fn finalize(env: &mut Env, seed: &[u8; 32]) -> Result<(), FailedTransactionMetadata> {
+    let ix = Instruction {
+        program_id: SORT,
+        accounts: sort::accounts::FinalizeDraw { governance: env.governance(SORT), pool: pool_pda(env), randomness: randomness_address(seed) }.to_account_metas(None),
+        data: sort::instruction::FinalizeDraw {}.data(),
+    };
+    let admin = env.admin.insecure_clone();
+    env.send(&[ix], &[&admin])
+}
+
+/// The draw the program should make: the same partial Fisher-Yates.
+fn expected_council(mut members: Vec<Pubkey>, randomness: &[u8; 64], seats: usize) -> Vec<Pubkey> {
+    let n = members.len();
+    for i in 0..seats.min(n) {
+        let h = solana_sha256_hasher::hashv(&[randomness, &(i as u64).to_le_bytes()]).to_bytes();
+        let r = u64::from_le_bytes(h[..8].try_into().unwrap());
+        members.swap(i, i + (r % (n - i) as u64) as usize);
+    }
+    members.truncate(seats.min(n));
+    members
+}
+
+fn propose(env: &mut Env, who: &Keypair) -> Result<Pubkey, FailedTransactionMetadata> {
+    let id = governance(env).proposal_count + 1;
+    let p = env.proposal_pda(SORT, id);
+    let ix = Instruction {
+        program_id: SORT,
+        accounts: sort::accounts::Propose { proposer: who.pubkey(), governance: env.governance(SORT), hub_dao: env.dao, proposal: p, system_program: SYSTEM }
+            .to_account_metas(None),
+        data: sort::instruction::Propose { id, metadata_uri: "Pay the host".into(), instructions: vec![env.pay_sol(&who.pubkey(), 1_000)] }.data(),
+    };
+    env.send(&[ix], &[who]).map(|_| p)
+}
+
+fn council_vote(env: &mut Env, who: &Keypair, p: Pubkey, choice: Choice) -> Result<(), FailedTransactionMetadata> {
+    let ix = Instruction {
+        program_id: SORT,
+        accounts: sort::accounts::CouncilAction { member: who.pubkey(), governance: env.governance(SORT), proposal: p }.to_account_metas(None),
+        data: sort::instruction::CastVote { choice }.data(),
+    };
+    env.send(&[ix], &[who])
+}
+
+fn queue(env: &mut Env, p: Pubkey) -> Result<(), FailedTransactionMetadata> {
+    let ix = Instruction {
+        program_id: SORT,
+        accounts: sort::accounts::Queue { governance: env.governance(SORT), proposal: p }.to_account_metas(None),
+        data: sort::instruction::Queue {}.data(),
+    };
+    let admin = env.admin.insecure_clone();
+    env.send(&[ix], &[&admin])
+}
+
+#[test]
+fn the_pool_needs_a_deposit_and_locks_it() {
+    let (mut env, ms) = sortition_dao(3, 2);
+    let small = env.member(1_000);
+    deposit(&mut env, &small, 50).unwrap();
+    assert_eq!(code(pool_action(&mut env, &small, true)), err(GovError::ProposalThresholdNotMet));
+    pool_action(&mut env, &ms[0], true).unwrap();
+    assert_eq!(code(pool_action(&mut env, &ms[0], true)), err(GovError::AlreadyEligible));
+    assert_eq!(code(withdraw(&mut env, &ms[0], 10)), err(GovError::LeavePoolFirst));
+    pool_action(&mut env, &ms[0], false).unwrap();
+    withdraw(&mut env, &ms[0], 100).unwrap();
+    assert_eq!(code(pool_action(&mut env, &ms[1], false)), err(GovError::NotEligible));
+}
+
+#[test]
+fn a_draw_seats_the_council_orao_randomness_picks_and_it_governs() {
+    let (mut env, ms) = sortition_dao(3, 6);
+    for m in &ms {
+        pool_action(&mut env, m, true).unwrap();
+    }
+    // The first council's proposal, made before the draw.
+    let creator = env.creator.insecure_clone();
+    let old = propose(&mut env, &creator).unwrap();
+
+    let nonce = [7u8; 32];
+    let seed = sort::draw_seed(&env.governance(SORT), 1, &nonce);
+    set_orao(&mut env, &seed, None, sort::ORAO_VRF);
+    assert_eq!(code(start_draw(&mut env, nonce, None)), err(GovError::TermNotOver));
+    env.warp(START + 1_000);
+    start_draw(&mut env, nonce, None).unwrap();
+    assert_eq!(code(pool_action(&mut env, &ms[0], false)), err(GovError::DrawInProgress), "pool frozen");
+    let late = env.member(1_000);
+    deposit(&mut env, &late, 100).unwrap();
+    assert_eq!(code(pool_action(&mut env, &late, true)), err(GovError::DrawInProgress));
+    assert_eq!(code(finalize(&mut env, &seed)), err(GovError::RandomnessNotReady));
+
+    let randomness = [42u8; 64];
+    let pool_before = pool(&env);
+    set_orao(&mut env, &seed, Some(randomness), sort::ORAO_VRF);
+    finalize(&mut env, &seed).unwrap();
+    let g = governance(&env);
+    assert_eq!(g.council, expected_council(pool_before, &randomness, 3), "exactly the draw the randomness gives");
+    assert_eq!((g.council.len(), g.council_term, g.draw_open), (3, 2, false));
+    assert_eq!(g.term_ends_at, START + 1_000 + 1_000);
+    assert_eq!(code(finalize(&mut env, &seed)), err(GovError::NoDrawInProgress));
+
+    // The old council's proposal died with it; the new council governs.
+    env.warp(START + 1_020);
+    assert_eq!(code(council_vote(&mut env, &creator, old, Choice::For)), err(GovError::NotCouncilMember));
+    let seated: Vec<&Member> = ms.iter().filter(|m| g.council.contains(&m.kp.pubkey())).collect();
+    let outsider = ms.iter().find(|m| !g.council.contains(&m.kp.pubkey())).unwrap();
+    assert_eq!(code(propose(&mut env, &outsider.kp)), err(GovError::NotCouncilMember));
+    let p = propose(&mut env, &seated[0].kp).unwrap();
+    env.warp(START + 1_030);
+    council_vote(&mut env, &seated[0].kp, p, Choice::For).unwrap();
+    assert_eq!(code(council_vote(&mut env, &seated[0].kp, p, Choice::For)), err(GovError::AlreadyVoted));
+    env.warp(START + 1_130);
+    assert_eq!(code(queue(&mut env, p)), err(GovError::QuorumNotReached), "quorum is 2 of 3");
+    let p2 = propose(&mut env, &seated[1].kp).unwrap();
+    env.warp(START + 1_140);
+    council_vote(&mut env, &seated[1].kp, p2, Choice::For).unwrap();
+    council_vote(&mut env, &seated[2].kp, p2, Choice::For).unwrap();
+    env.warp(START + 1_240);
+    queue(&mut env, p2).unwrap();
+    env.warp(START + 1_290);
+    let who = seated[1].kp.pubkey();
+    let before = env.lamports(&who);
+    env.execute(SORT, p2).unwrap();
+    assert_eq!(env.lamports(&who) - before, 1_000);
+}
+
+#[test]
+fn only_an_unanswered_orao_request_can_start_a_draw() {
+    let (mut env, ms) = sortition_dao(2, 3);
+    for m in &ms {
+        pool_action(&mut env, m, true).unwrap();
+    }
+    env.warp(START + 1_000);
+    let nonce = [1u8; 32];
+    let seed = sort::draw_seed(&env.governance(SORT), 1, &nonce);
+    assert!(start_draw(&mut env, nonce, None).is_err(), "no request at all");
+    set_orao(&mut env, &seed, None, Pubkey::new_unique());
+    assert_eq!(code(start_draw(&mut env, nonce, None)), err(GovError::WrongRandomnessAccount), "not owned by ORAO");
+    set_orao(&mut env, &seed, Some([9u8; 64]), sort::ORAO_VRF);
+    assert_eq!(code(start_draw(&mut env, nonce, None)), err(GovError::RandomnessAlreadyFulfilled), "a result already known can't be used");
+}
+
+#[test]
+fn a_stuck_draw_restarts_only_while_its_request_is_unanswered() {
+    let (mut env, ms) = sortition_dao(2, 3);
+    for m in &ms {
+        pool_action(&mut env, m, true).unwrap();
+    }
+    env.warp(START + 1_000);
+    let first = sort::draw_seed(&env.governance(SORT), 1, &[1u8; 32]);
+    set_orao(&mut env, &first, None, sort::ORAO_VRF);
+    start_draw(&mut env, [1u8; 32], None).unwrap();
+
+    let second = sort::draw_seed(&env.governance(SORT), 1, &[2u8; 32]);
+    set_orao(&mut env, &second, None, sort::ORAO_VRF);
+    assert_eq!(code(start_draw(&mut env, [2u8; 32], Some(first))), err(GovError::DrawInProgress), "before the timeout");
+    env.warp(START + 1_060);
+    // If the first request got answered meanwhile, it must be used.
+    set_orao(&mut env, &first, Some([3u8; 64]), sort::ORAO_VRF);
+    assert_eq!(code(start_draw(&mut env, [2u8; 32], Some(first))), err(GovError::RandomnessAlreadyFulfilled));
+    set_orao(&mut env, &first, None, sort::ORAO_VRF);
+    start_draw(&mut env, [2u8; 32], Some(first)).unwrap();
+    let g = governance(&env);
+    assert_eq!((g.draw_count, g.draw_seed), (1, second), "same draw, new request");
+    // Only the new request's answer counts.
+    set_orao(&mut env, &first, Some([3u8; 64]), sort::ORAO_VRF);
+    assert_eq!(code(finalize(&mut env, &first)), err(GovError::WrongRandomnessAccount));
+    set_orao(&mut env, &second, Some([5u8; 64]), sort::ORAO_VRF);
+    finalize(&mut env, &second).unwrap();
+}
+
+#[test]
+fn a_pool_smaller_than_the_seats_seats_everyone() {
+    let (mut env, ms) = sortition_dao(5, 2);
+    for m in &ms {
+        pool_action(&mut env, m, true).unwrap();
+    }
+    env.warp(START + 1_000);
+    let seed = sort::draw_seed(&env.governance(SORT), 1, &[0u8; 32]);
+    set_orao(&mut env, &seed, None, sort::ORAO_VRF);
+    start_draw(&mut env, [0u8; 32], None).unwrap();
+    set_orao(&mut env, &seed, Some([1u8; 64]), sort::ORAO_VRF);
+    finalize(&mut env, &seed).unwrap();
+    let g = governance(&env);
+    assert_eq!(g.council.len(), 2);
+    assert_eq!(g.quorum(), 2, "quorum capped at the council's size");
+}
diff --git a/tests/tests/sowellian.rs b/tests/tests/sowellian.rs
new file mode 100644
index 0000000..eed6bd9
--- /dev/null
+++ b/tests/tests/sowellian.rs
@@ -0,0 +1,435 @@
+//! Sowellian: approval, the YES/NO market, execution through the hub, and
+//! every resolution path - Pyth oracle, unchallenged and adjudicated human
+//! resolution - with claims, bonds and voids.
+
+use solana_account::Account;
+use vortex_sowellian as sow;
+use vortex_sowellian::{Criteria, Outcome, Phase, ResolutionMethod, Side, SowellianConfig, VoteChoice as Choice};
+use vortex_tests::*;
+
+const FEED: [u8; 32] = [0xEF; 32];
+
+fn sow_config() -> SowellianConfig {
+    SowellianConfig {
+        proposal_bond: 50,
+        approval_voting_delay: 10,
+        approval_voting_period: 100,
+        approval_quorum_bps: 1_000,
+        approval_threshold_bps: 6_000,
+        positions_window: 100,
+        execution_timelock: 50,
+        execution_period: 200,
+        resolution_bond: 20,
+        challenge_period: 100,
+        challenge_bond: 30,
+        adjudication_voting_period: 100,
+        adjudication_quorum_bps: 1_000,
+        adjudication_threshold_bps: 6_000,
+        max_oracle_staleness: 60,
+    }
+}
+
+fn escrow(env: &Env) -> Pubkey {
+    Pubkey::find_program_address(&[sow::ESCROW_SEED, env.governance(SOW).as_ref()], &SOW).0
+}
+
+fn pda(seed: &[u8], p: &Pubkey, owner: &Pubkey) -> Pubkey {
+    Pubkey::find_program_address(&[seed, p.as_ref(), owner.as_ref()], &SOW).0
+}
+
+fn proposal(env: &Env, p: Pubkey) -> sow::Proposal {
+    sow::Proposal::try_deserialize(&mut env.svm.get_account(&p).unwrap().data.as_slice()).unwrap()
+}
+
+fn governance(env: &Env) -> sow::Governance {
+    sow::Governance::try_deserialize(&mut env.svm.get_account(&env.governance(SOW)).unwrap().data.as_slice()).unwrap()
+}
+
+/// A Sowellian DAO: alice deposits 600, bob 400; both keep 400 in their wallets for bonds and positions.
+fn sowellian_dao() -> (Env, Member, Member) {
+    let mut env = Env::bare(litesvm_token::TOKEN_ID);
+    let creator = env.creator.pubkey();
+    env.create_dao("Sowell", SOW, |env| Instruction {
+        program_id: SOW,
+        accounts: sow::accounts::InitGovernance {
+            authority: creator,
+            payer: creator,
+            hub_dao: env.dao,
+            governance: env.governance(SOW),
+            mint: env.mint,
+            vault: env.vault(SOW),
+            escrow: escrow(env),
+            token_program: env.token_program,
+            system_program: SYSTEM,
+        }
+        .to_account_metas(None),
+        data: sow::instruction::InitGovernance { config: sow_config() }.data(),
+    });
+    let alice = env.member(1_000);
+    let bob = env.member(800);
+    deposit(&mut env, &alice, 600).unwrap();
+    deposit(&mut env, &bob, 400).unwrap();
+    env.svm.airdrop(&env.treasury, 5_000_000_000).unwrap();
+    (env, alice, bob)
+}
+
+fn send(env: &mut Env, who: &Keypair, accounts: Vec<AccountMeta>, data: Vec<u8>) -> Result<(), FailedTransactionMetadata> {
+    env.send(&[Instruction { program_id: SOW, accounts, data }], &[who])
+}
+
+fn deposit(env: &mut Env, m: &Member, amount: u64) -> Result<(), FailedTransactionMetadata> {
+    let a = sow::accounts::Deposit {
+        owner: m.kp.pubkey(),
+        governance: env.governance(SOW),
+        voter: env.voter_pda(SOW, &m.kp.pubkey()),
+        owner_token_account: m.ata,
+        vault: env.vault(SOW),
+        mint: env.mint,
+        token_program: env.token_program,
+        system_program: SYSTEM,
+    };
+    send(env, &m.kp, a.to_account_metas(None), sow::instruction::Deposit { amount }.data())
+}
+
+fn withdraw(env: &mut Env, m: &Member, amount: u64) -> Result<(), FailedTransactionMetadata> {
+    let a = sow::accounts::Withdraw {
+        owner: m.kp.pubkey(),
+        governance: env.governance(SOW),
+        voter: env.voter_pda(SOW, &m.kp.pubkey()),
+        owner_token_account: m.ata,
+        vault: env.vault(SOW),
+        mint: env.mint,
+        token_program: env.token_program,
+    };
+    send(env, &m.kp, a.to_account_metas(None), sow::instruction::Withdraw { amount }.data())
+}
+
+fn human() -> Criteria {
+    Criteria { method: ResolutionMethod::Human, feed_id: [0; 32], target_value: 0, target_is_minimum: true, measurement_period: 100 }
+}
+
+fn oracle(target: i128) -> Criteria {
+    Criteria { method: ResolutionMethod::Oracle, feed_id: FEED, target_value: target, target_is_minimum: true, measurement_period: 100 }
+}
+
+fn propose(env: &mut Env, m: &Member, criteria: Criteria) -> Result<Pubkey, FailedTransactionMetadata> {
+    let id = governance(env).proposal_count + 1;
+    let p = env.proposal_pda(SOW, id);
+    let a = sow::accounts::Propose {
+        proposer: m.kp.pubkey(),
+        governance: env.governance(SOW),
+        hub_dao: env.dao,
+        proposal: p,
+        proposer_token_account: m.ata,
+        escrow: escrow(env),
+        mint: env.mint,
+        token_program: env.token_program,
+        system_program: SYSTEM,
+    };
+    let ix = sow::instruction::Propose { id, metadata_uri: "Grow monthly users past 1,000".into(), instructions: vec![env.pay_sol(&m.kp.pubkey(), 1_000)], criteria };
+    send(env, &m.kp, a.to_account_metas(None), ix.data()).map(|_| p)
+}
+
+fn approve_vote(env: &mut Env, m: &Member, p: Pubkey, choice: Choice) -> Result<(), FailedTransactionMetadata> {
+    let o = m.kp.pubkey();
+    let a = sow::accounts::CastApprovalVote {
+        owner: o,
+        governance: env.governance(SOW),
+        proposal: p,
+        voter: env.voter_pda(SOW, &o),
+        vote_record: pda(sow::APPROVAL_VOTE_SEED, &p, &o),
+        system_program: SYSTEM,
+    };
+    send(env, &m.kp, a.to_account_metas(None), sow::instruction::CastApprovalVote { choice }.data())
+}
+
+fn settle(env: &mut Env, p: Pubkey, data: Vec<u8>) -> Result<(), FailedTransactionMetadata> {
+    let admin = env.admin.insecure_clone();
+    let a = sow::accounts::Settle { governance: env.governance(SOW), proposal: p };
+    send(env, &admin, a.to_account_metas(None), data)
+}
+
+fn take(env: &mut Env, m: &Member, p: Pubkey, side: Side, amount: u64) -> Result<(), FailedTransactionMetadata> {
+    let o = m.kp.pubkey();
+    let a = sow::accounts::TakePosition {
+        owner: o,
+        governance: env.governance(SOW),
+        proposal: p,
+        position: pda(sow::POSITION_SEED, &p, &o),
+        owner_token_account: m.ata,
+        escrow: escrow(env),
+        mint: env.mint,
+        token_program: env.token_program,
+        system_program: SYSTEM,
+    };
+    send(env, &m.kp, a.to_account_metas(None), sow::instruction::TakePosition { side, amount }.data())
+}
+
+fn bond_action(env: &mut Env, m: &Member, p: Pubkey, data: Vec<u8>) -> Result<(), FailedTransactionMetadata> {
+    let a = sow::accounts::BondAction {
+        owner: m.kp.pubkey(),
+        governance: env.governance(SOW),
+        proposal: p,
+        owner_token_account: m.ata,
+        escrow: escrow(env),
+        mint: env.mint,
+        token_program: env.token_program,
+    };
+    send(env, &m.kp, a.to_account_metas(None), data)
+}
+
+fn adjudicate(env: &mut Env, m: &Member, p: Pubkey, outcome: Outcome) -> Result<(), FailedTransactionMetadata> {
+    let o = m.kp.pubkey();
+    let a = sow::accounts::CastAdjudicationVote {
+        owner: o,
+        governance: env.governance(SOW),
+        proposal: p,
+        voter: env.voter_pda(SOW, &o),
+        vote_record: pda(sow::ADJUDICATION_VOTE_SEED, &p, &o),
+        system_program: SYSTEM,
+    };
+    send(env, &m.kp, a.to_account_metas(None), sow::instruction::CastAdjudicationVote { outcome }.data())
+}
+
+fn claim_position(env: &mut Env, m: &Member, p: Pubkey) -> Result<(), FailedTransactionMetadata> {
+    let o = m.kp.pubkey();
+    let a = sow::accounts::ClaimPosition {
+        owner: o,
+        governance: env.governance(SOW),
+        proposal: p,
+        position: pda(sow::POSITION_SEED, &p, &o),
+        owner_token_account: m.ata,
+        escrow: escrow(env),
+        mint: env.mint,
+        token_program: env.token_program,
+    };
+    send(env, &m.kp, a.to_account_metas(None), sow::instruction::ClaimPosition {}.data())
+}
+
+fn claim_bond(env: &mut Env, m: &Member, p: Pubkey) -> Result<(), FailedTransactionMetadata> {
+    let a = sow::accounts::ClaimBond {
+        owner: m.kp.pubkey(),
+        governance: env.governance(SOW),
+        proposal: p,
+        owner_token_account: m.ata,
+        escrow: escrow(env),
+        mint: env.mint,
+        token_program: env.token_program,
+    };
+    send(env, &m.kp, a.to_account_metas(None), sow::instruction::ClaimBond {}.data())
+}
+
+fn treasury_ata(env: &mut Env) -> Pubkey {
+    let creator = env.creator.insecure_clone();
+    let (mint, treasury) = (env.mint, env.treasury);
+    CreateAssociatedTokenAccount::new(&mut env.svm, &creator, &mint).owner(&treasury).send().unwrap()
+}
+
+fn sweep(env: &mut Env, to: Pubkey) -> Result<(), FailedTransactionMetadata> {
+    let a = sow::accounts::SweepToTreasury { governance: env.governance(SOW), treasury_token_account: to, escrow: escrow(env), mint: env.mint, token_program: env.token_program };
+    let admin = env.admin.insecure_clone();
+    send(env, &admin, a.to_account_metas(None), sow::instruction::SweepToTreasury {}.data())
+}
+
+/// Propose, approve with alice, open positions: alice YES 100, bob NO 300.
+fn approved_with_positions(env: &mut Env, alice: &Member, bob: &Member, criteria: Criteria) -> Pubkey {
+    let p = propose(env, alice, criteria).unwrap();
+    env.warp(START + 10);
+    approve_vote(env, alice, p, Choice::For).unwrap();
+    env.warp(START + 110);
+    settle(env, p, sow::instruction::FinalizeApproval {}.data()).unwrap();
+    assert_eq!(proposal(env, p).phase, Phase::PositionsOpen);
+    take(env, alice, p, Side::Yes, 100).unwrap();
+    take(env, bob, p, Side::No, 300).unwrap();
+    p
+}
+
+/// Positions close at 210; executable 260..460; measurement ends 100 s after execution.
+fn execute(env: &mut Env, p: Pubkey) {
+    env.warp(START + 260);
+    env.execute(SOW, p).unwrap();
+}
+
+fn set_price(env: &mut Env, feed: [u8; 32], price: i64, expo: i32, publish_time: i64, full: bool, owner: Pubkey) -> Pubkey {
+    let mut data = sow::PRICE_UPDATE_V2.to_vec();
+    data.extend_from_slice(Pubkey::new_unique().as_ref()); // write authority
+    if full {
+        data.push(1);
+    } else {
+        data.extend_from_slice(&[0, 5]);
+    }
+    data.extend_from_slice(&feed);
+    data.extend_from_slice(&price.to_le_bytes());
+    data.extend_from_slice(&1u64.to_le_bytes()); // conf
+    data.extend_from_slice(&expo.to_le_bytes());
+    data.extend_from_slice(&publish_time.to_le_bytes());
+    data.extend_from_slice(&(publish_time - 1).to_le_bytes());
+    data.extend_from_slice(&[0u8; 8 + 8 + 8]); // ema price, ema conf, posted slot
+    let address = Pubkey::new_unique();
+    env.svm.set_account(address, Account { lamports: 10_000_000, data, owner, executable: false, rent_epoch: 0 }).unwrap();
+    address
+}
+
+fn resolve_oracle(env: &mut Env, p: Pubkey, price_update: Pubkey) -> Result<(), FailedTransactionMetadata> {
+    let a = sow::accounts::ResolveViaOracle { governance: env.governance(SOW), proposal: p, price_update };
+    let admin = env.admin.insecure_clone();
+    send(env, &admin, a.to_account_metas(None), sow::instruction::ResolveViaOracle {}.data())
+}
+
+#[test]
+fn human_resolution_unchallenged_pays_the_winners_and_returns_bonds() {
+    let (mut env, alice, bob) = sowellian_dao();
+    let p = approved_with_positions(&mut env, &alice, &bob, human());
+    assert_eq!(env.token_balance(&escrow(&env)), 50 + 400, "bond + positions held in escrow");
+    env.warp(START + 210);
+    assert_eq!(code(take(&mut env, &bob, p, Side::No, 1)), err(GovError::PositionsClosed));
+    assert_eq!(code(env.execute(SOW, p)), err(GovError::ProposalNotExecutable), "timelock after the positions window");
+    let before = env.lamports(&alice.kp.pubkey());
+    execute(&mut env, p);
+    assert_eq!(env.lamports(&alice.kp.pubkey()) - before, 1_000, "paid by the hub treasury");
+    assert_eq!(code(bond_action(&mut env, &bob, p, sow::instruction::ProposeResolution { outcome: Outcome::Success }.data())), err(GovError::MeasurementNotOver));
+    env.warp(START + 360);
+    bond_action(&mut env, &bob, p, sow::instruction::ProposeResolution { outcome: Outcome::Success }.data()).unwrap();
+    assert_eq!(code(settle(&mut env, p, sow::instruction::FinalizeUnchallenged {}.data())), err(GovError::ChallengeWindowOpen));
+    env.warp(START + 460);
+    settle(&mut env, p, sow::instruction::FinalizeUnchallenged {}.data()).unwrap();
+    assert_eq!(proposal(&env, p).final_outcome, Outcome::Success);
+
+    let alice_before = env.token_balance(&alice.ata);
+    claim_position(&mut env, &alice, p).unwrap();
+    assert_eq!(env.token_balance(&alice.ata) - alice_before, 400, "the whole pool to the only YES");
+    assert_eq!(code(claim_position(&mut env, &alice, p)), err(GovError::AlreadyClaimed));
+    assert_eq!(code(claim_position(&mut env, &bob, p)), err(GovError::NothingToClaim));
+    let (a0, b0) = (env.token_balance(&alice.ata), env.token_balance(&bob.ata));
+    claim_bond(&mut env, &alice, p).unwrap();
+    claim_bond(&mut env, &bob, p).unwrap();
+    assert_eq!((env.token_balance(&alice.ata) - a0, env.token_balance(&bob.ata) - b0), (50, 20), "proposal bond, resolution bond");
+    assert_eq!(env.token_balance(&escrow(&env)), 0, "escrow empty");
+}
+
+#[test]
+fn a_challenge_goes_to_a_token_vote_and_the_wrong_side_loses_its_bond() {
+    // The resolver says Success; the vote finds Failure.
+    let (mut env, alice, bob) = sowellian_dao();
+    let p = approved_with_positions(&mut env, &alice, &bob, human());
+    execute(&mut env, p);
+    env.warp(START + 360);
+    bond_action(&mut env, &alice, p, sow::instruction::ProposeResolution { outcome: Outcome::Success }.data()).unwrap();
+    bond_action(&mut env, &bob, p, sow::instruction::ChallengeResolution {}.data()).unwrap();
+    assert_eq!(code(bond_action(&mut env, &bob, p, sow::instruction::ChallengeResolution {}.data())), err(GovError::WrongPhase));
+    adjudicate(&mut env, &bob, p, Outcome::Failure).unwrap();
+    adjudicate(&mut env, &alice, p, Outcome::Success).unwrap();
+    assert_eq!(code(withdraw(&mut env, &bob, 1)), err(GovError::TokensLocked), "adjudication votes lock deposits");
+    assert_eq!(code(settle(&mut env, p, sow::instruction::FinalizeAdjudication {}.data())), err(GovError::VotingNotEnded));
+    env.warp(START + 460);
+    settle(&mut env, p, sow::instruction::FinalizeAdjudication {}.data()).unwrap();
+    // 600 success of 1000: exactly the 60% threshold, so Success.
+    let pr = proposal(&env, p);
+    assert_eq!(pr.final_outcome, Outcome::Success);
+    assert_eq!((pr.owed_resolver, pr.owed_challenger, governance(&env).owed_treasury), (20, 0, 30), "challenger was wrong");
+    let ta = treasury_ata(&mut env);
+    sweep(&mut env, ta).unwrap();
+    assert_eq!(env.token_balance(&ta), 30);
+    assert_eq!(code(sweep(&mut env, ta)), err(GovError::NothingToClaim));
+
+    // Same again, but bob holds more weight: Failure, resolver loses.
+    let (mut env, alice, bob) = sowellian_dao();
+    let creator = env.creator.insecure_clone();
+    let mint = env.mint;
+    MintTo::new(&mut env.svm, &creator, &mint, &bob.ata, 300).send().unwrap();
+    deposit(&mut env, &bob, 300).unwrap();
+    let p = approved_with_positions(&mut env, &alice, &bob, human());
+    execute(&mut env, p);
+    env.warp(START + 360);
+    bond_action(&mut env, &alice, p, sow::instruction::ProposeResolution { outcome: Outcome::Success }.data()).unwrap();
+    bond_action(&mut env, &bob, p, sow::instruction::ChallengeResolution {}.data()).unwrap();
+    adjudicate(&mut env, &bob, p, Outcome::Failure).unwrap();
+    adjudicate(&mut env, &alice, p, Outcome::Success).unwrap();
+    env.warp(START + 460);
+    settle(&mut env, p, sow::instruction::FinalizeAdjudication {}.data()).unwrap();
+    let pr = proposal(&env, p);
+    assert_eq!(pr.final_outcome, Outcome::Failure);
+    assert_eq!((pr.owed_resolver, pr.owed_challenger, governance(&env).owed_treasury), (0, 30, 20));
+    let b0 = env.token_balance(&bob.ata);
+    claim_position(&mut env, &bob, p).unwrap();
+    claim_bond(&mut env, &bob, p).unwrap();
+    assert_eq!(env.token_balance(&bob.ata) - b0, 400 + 30, "NO wins the pool; challenge bond back");
+}
